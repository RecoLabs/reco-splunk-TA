<form version="1.1" theme="dark">
  <label>Reco : Accounts</label>
  <search id="main">
    <query> `reco-index` source=reco_accounts sourcetype=recoAccounts [| tstats latest(_time) as latest where   `reco-index` source=reco_accounts sourcetype=recoAccounts earliest=-15d latest=now| eval earliest=latest-3600 | eval latest=latest+10 | table earliest latest]| rex field=account_type "(?&lt;Instance&gt;.*)_ACCOUNT" 
| stats  values(analysis_account_status{}) as Analysis values(analysis{}) as analysis values(has_mfa) as HasMFA  values(roles{}) as Roles latest(user_type_display) as user_type_display  latest(is_admin) as is_admin latest(is_standard) as is_standard latest(alerts_count) as "Open Alerts" latest(last_seen_time) as "Last Seen" latest(is_guest_insight) as is_guest_insight by full_name Instance primary_email_address instance_id  creation_time
| eval Analysis= mvappend(analysis,Analysis) </query>
   
    <sampleRatio>1</sampleRatio>
  </search>
  <fieldset submitButton="false">
    <!--<input type="time" token="time_token" searchWhenChanged="true">-->
    <!--  <label>Time Range</label>-->
    <!--  <default>-->
    <!--    <earliest>0</earliest>-->
    <!--    <latest></latest>-->
    <!--  </default>-->
    <!--</input>-->
    <input type="dropdown" token="name" searchWhenChanged="true">
      <label>Name</label>
      <fieldForLabel>full_name</fieldForLabel>
      <fieldForValue>full_name</fieldForValue>
      <search base="main">
        <query>| stats count by full_name</query>
      </search>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
    <input type="dropdown" token="email" searchWhenChanged="true">
      <label>Email</label>
      <fieldForLabel>primary_email_address</fieldForLabel>
      <fieldForValue>primary_email_address</fieldForValue>
      <search base="main">
        <query>| stats count by primary_email_address</query>
      </search>
      <choice value="*">All</choice>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
  </fieldset>
  <row>
    <panel>
      <single>
        <title>Accounts</title>
        <search base="main">
          <query>| stats count</query>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>NO MFA</title>
        <search base="main">
          <query>| search HasMFA="NOMFA" | stats count</query>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>INACTIVE</title>
        <search base="main">
          <query>| search Analysis="inactive" | stats count</query>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>GUEST</title>
        <search base="main">
          <query>| search is_guest_insight="true" | stats count</query>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>ADMIN</title>
        <search base="main">
          <query>| search user_type_display="ADMIN" | stats count</query>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>ADMIN - NO MFA</title>
        <search base="main">
          <query>| search user_type_display="ADMIN" AND HasMFA="NOMFA" | stats count</query>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>ADMIN - INACTIVE</title>
        <search base="main">
          <query>| search is_admin="true" AND  Analysis="inactive" | stats count</query>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Account Information</title>
      <table>
        <search base="main">
          <query>| eval primary_email_address=if(primary_email_address=="null","",primary_email_address)
| search full_name=$name|s$ AND primary_email_address=$email|s$
| rename full_name as Name, primary_email_address as  "Account Email", HasMFA as "Has MFA", user_type_display as Permissions
| table Name Instance "Account Email" "Last Seen" Analysis "Has MFA" Roles Permissions "Open Alerts"
| fillnull value="-" Roles</query>
        </search>
        <option name="count">100</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">none</option>
        <option name="percentagesRow">false</option>
        <option name="refresh.display">progressbar</option>
        <option name="rowNumbers">true</option>
        <option name="totalsRow">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</form>